pipeline {
    agent any
    
        stages {
                  stage('removing-oldjar') {
                  steps {
                      sh '''
                       #!/bin/bash
                       rm -f /opt/app/*.jar
                       rm -f /opt/app/app.log '''
           }
        }

        stage('rollback') {
            steps {
                sh '''cd /opt/app/

                   temp=$(aws s3 ls s3://sayli-paresh | awk '{print $4}' |sort -t "-" -nk3 |tail -2 |head -1)
                   echo "Latest build: $temp"

                   aws s3 cp s3://sayli-paresh/$temp /opt/app/app.jar
                   java -jar /opt/app/app.jar > /opt/app/app.log 2>&1 &'''
            }
        }
    }
}
