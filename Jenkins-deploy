pipeline {
    agent any
    
    environment {
        S3_BUCKET = 'sayli-paresh'
        REMOTE_USER = 'ec2-user'
        REMOTE_HOST = '172.31.5.98'
        REMOTE_DIR = '/opt/app'
    }
    
    stages {
        stage('Remove old jars and logs') {
            steps {
                    sh "ssh ${REMOTE_USER}@${REMOTE_HOST} 'rm -f ${REMOTE_DIR}/*.jar ${REMOTE_DIR}/app.log'"
            }
        }

        stage('Get latest artifact from S3') {
            steps {
                  sh '''
                   temp=$(aws s3 ls s3://${S3_BUCKET} | awk '{print $4}' |sort -t "-" -nk4 |tail -1)
                   echo "Latest build: $temp"
                   '''
            }
        }

        stage('Deploy artifact to prod') {
            steps {
                sh """
                   ssh ec2-user@172.31.5.98 '
                   temp=\$(aws s3 ls s3://sayli-paresh | awk "{print \\\$4}" | sort -t "-" -nk4 | tail -1)
                   aws s3 cp s3://sayli-paresh/\$temp /opt/app/app.jar
                   java -jar /opt/app/app.jar > /opt/app/app.log 2>&1 &
                  '
                """
            }
        }
    }
}
